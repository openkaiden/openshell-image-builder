# Root filesystem for the build microVM. This is not the image being built —
# it is the Linux userspace the VM boots into to run buildah.
FROM alpine:edge

# buildah lives in the community repo, which is not enabled in the base image.
RUN echo "https://dl-cdn.alpinelinux.org/alpine/edge/community" >> /etc/apk/repositories && \
    apk add --no-cache buildah netavark

# virtiofs does not support overlayfs, so tell buildah to use vfs instead.
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "vfs"\n' > /etc/containers/storage.conf

# The libkrun TSI network backend proxies all inet connections through the host,
# but the guest still needs /etc/resolv.conf to point to a reachable nameserver.
# Loopback addresses (127.0.0.53 from systemd-resolved) are not routable via TSI.
RUN echo "nameserver 1.1.1.1" > /etc/resolv.conf

# Build helper invoked by the host process inside the microVM.
COPY vm-build /usr/local/bin/vm-build
RUN chmod +x /usr/local/bin/vm-build
